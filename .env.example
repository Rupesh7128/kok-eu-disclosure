# The generators need NO keys and call no external service.
# Nothing here is required; there are no secrets in this project.

# Free generations per IP per UTC day on the hosted /api/mcp endpoint
# (in-memory; resets on cold start on serverless hosts).
FREE_GENERATIONS_PER_DAY=30

